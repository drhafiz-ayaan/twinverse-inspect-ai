<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="probe">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.2 -0.9</direction>
    </light>
    <model name="target">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>1 1 1</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual></link>
    </model>
    <model name="cam">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="l">
        <sensor name="rgb" type="camera">
          <camera><horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.1</near><far>100</far></clip></camera>
          <always_on>1</always_on><update_rate>10</update_rate>
          <topic>probe_cam</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
