# Copy to .env and adjust. `.env` is gitignored; this file is not.
# Defaults below match the local dev services in the README (setup step 6).

DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:devpass@localhost:5432/twinverse

# --- Object storage (MinIO locally) ---
# For Alibaba Cloud OSS or AWS S3, change these values only - no code changes.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=twinverse-inspections
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Upload limits (bytes) ---
MAX_IMAGE_BYTES=26214400
MAX_VIDEO_BYTES=524288000

# Lifetime of presigned download links handed to the dashboard.
PRESIGN_EXPIRY_SECONDS=3600
