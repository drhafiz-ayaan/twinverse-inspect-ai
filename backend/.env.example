# Copy to .env and adjust. `.env` is gitignored; this file is not.
# Defaults below match the local dev services in the README (setup step 6).

DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:devpass@localhost:5432/twinverse

# --- Object storage (MinIO locally) ---
# For Alibaba Cloud OSS or AWS S3, change these values only - no code changes.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=twinverse-inspections
S3_REGION=us-east-1
S3_USE_SSL=false
ROBOFLOW_API_KEY=***REMOVED***

# --- Upload limits (bytes) ---
MAX_IMAGE_BYTES=26214400
MAX_VIDEO_BYTES=524288000

# Lifetime of presigned download links handed to the dashboard.
PRESIGN_EXPIRY_SECONDS=3600

# --- Inference (Phase 2) ---
# A bare name is resolved and downloaded by Ultralytics; an absolute path points
# at a fine-tuned checkpoint from ml/train.py.
#
# NOTE: yolo11n.pt is COCO-pretrained - it detects people and cars, NOT cracks.
# It proves the pipeline runs. Replace it with a fine-tuned checkpoint before
# any claim about defect detection is meaningful.
MODEL_WEIGHTS=yolo11n.pt

# "cuda:0", "cpu", or leave unset to let Ultralytics choose.
INFERENCE_DEVICE=cuda:0

CONFIDENCE_THRESHOLD=0.25

# Video is sampled, not decoded frame by frame: adjacent frames show the same
# defect, so processing all of them multiplies runtime for no new information.
VIDEO_FRAME_STRIDE=15
VIDEO_MAX_FRAMES=300
