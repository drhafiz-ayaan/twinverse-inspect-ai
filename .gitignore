# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# ML — datasets and weights (see README: use Git LFS or GitHub Releases)
# Directory contents are excluded with /* rather than /, so the documentation
# inside can be un-ignored: a negation cannot escape an excluded directory.
ml/datasets/*
!ml/datasets/README.md
ml/weights/*
!ml/weights/.gitkeep
ml/runs/
runs/
*.pt
*.onnx
*.engine

# Media / uploads
uploads/
*.mp4
*.mov

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
